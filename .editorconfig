# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true
# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
# indent_style = space
indent_size = 2
trim_trailing_whitespace = true
tab_width = 8

[{*[Mm]akefile*,*.mak,*.mk,depend}]
indent_style = tab
indent_size = tab

[Makefile]
indent_style = tab
indent_size = tab

[*.rb]
# max_line_length = 120

[*.py]
indent_size = 4
indent_style = space

[*.rs]
indent_size = 4

[config]
indent_size = 8

[.gitconfig]
indent_style = tab

[*.swift]
indent_size = 4
indent_style = space

[*.lua]
indent_size = 2

[*.css]
indent_size = 2

[*.go]
indent_style = tab
indent_size = 8

[*.zig]
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
